\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Figure 1.} The logical architecture of the framework. Arrows indicate dependency: an item cannot be established before those above it. The forcing result at the centre is what compelled the introduction of internal structure and therefore the gauge decision of Part IV.}}{4}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Figure 2.} The fourth moment evaluated at 400 random directions on $S^3$, for the true D₄ root system (24 terms) against the hypercubic stand-in (8 terms) from which the claimed anisotropy coefficient was derived. The D₄ sum is constant to machine precision; the hypercubic sum varies by 32\% with direction. These are not the same calculation.}}{6}{figure.2}\protected@file@percent }
\gdef \LT@i {\LT@entry 
    {1}{26.64017pt}\LT@entry 
    {1}{75.81659pt}\LT@entry 
    {1}{44.06158pt}\LT@entry 
    {1}{314.41666pt}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Figure 3.} \textit  {Left:} spectral power with the triad coupling on versus off. \textit  {Right:} the parameter-free ordering criterion in four dimensions, with the validated three-dimensional BCC value marked for scale.}}{11}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Figure 4.} Phase diagram in the plane of baseline tension and quench depth. The full 24-mode D₄ standing wave occupies a contiguous band situated along the boundary with the disordered phase. Lower-symmetry sub-patterns occupy the higher-tension region.}}{12}{figure.4}\protected@file@percent }
\gdef \LT@ii {\LT@entry 
    {1}{121.98737pt}\LT@entry 
    {1}{153.76105pt}\LT@entry 
    {1}{185.18658pt}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Figure 5.} The stability quantity at the worst-case Brillouin-zone mode against time step.}}{16}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Figure 6.} Exact dispersion against the envelope approximation, and the resulting relative error.}}{17}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Figure 7.} Scaling exponents against spatial dimension. The four-derivative term is scale-invariant precisely at $d=4$, where the two-derivative and potential terms are both strongly contracting.}}{18}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Figure 8.} Confirmed regular-subalgebra branchings of $\symfrak {so}(8)$, showing that neither route reaches the Standard Model jointly.}}{19}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Figure 9.} \textit  {Left:} the 24 vertices coloured by coset of $Q_8$ in 2T. \textit  {Right:} the resulting structural chain from substrate to Standard Model.}}{22}{figure.9}\protected@file@percent }
